{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python3 || command -v python)\" \"$CLAUDE_PROJECT_DIR/scripts/check_leaks.py\" --hook",
            "timeout": 120,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
